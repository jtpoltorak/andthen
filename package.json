{
  "name": "andthen",
  "private": true,
  "description": "Small habits, linked to what you already do.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @andthen/web",
    "build": "npm run build -w @andthen/web",
    "test": "npm test -w @andthen/core && npm test -w @andthen/web -- --watch=false",
    "test:core": "npm test -w @andthen/core",
    "typecheck": "npm run typecheck -w @andthen/core",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "npm@10.9.9",
  "devDependencies": {
    "wrangler": "^4.156.2"
  }
}
