{
  "name": "andthen",
  "version": "1.11.0",
  "private": true,
  "description": "Small habits, linked to what you already do.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @andthen/web",
    "build": "npm run build -w @andthen/web",
    "test": "npm test -w @andthen/core && npm test -w @andthen/api && npm test -w @andthen/web -- --watch=false",
    "test:core": "npm test -w @andthen/core",
    "typecheck": "npm run typecheck -w @andthen/core && npm run typecheck -w @andthen/api",
    "test:api": "npm test -w @andthen/api",
    "build:api": "npm run build -w @andthen/api",
    "start:api": "npm run dev -w @andthen/api",
    "changelog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/changelog.mjs",
    "changelog:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/changelog.mjs --check"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "npm@10.9.9"
}
