// Cloudflare deploy config. AndThen is a static app with no server code,
// so this Worker only serves the built files in apps/web/dist/web/browser.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andthen",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist/web/browser",
    // Deep links like /routines or /progress get index.html, and the Angular router takes over.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
